GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
CATALOGUE_PATH=fashion_chatbot_catalogue_faqs.xlsx
BOT_USER_NAME=Shivi

